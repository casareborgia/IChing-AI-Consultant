POSTGRES_USER=iching
POSTGRES_PASSWORD=changeme
POSTGRES_DB=iching
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://iching:changeme@localhost:5432/iching

# --- 어느 모델로 돌릴지 ---
# 시험은 로컬, 서비스는 상용 API다 (CLAUDE.md 모델 운영 절).
#   개발·시험  LLM_PROVIDER=ollama   비용 0으로 무제한 반복
#   배포       LLM_PROVIDER=gemini   Cloud Run이 가벼워야 scale-to-zero가 된다
LLM_PROVIDER=ollama

# --- 로컬 (개발·시험) ---
# 2026-08-16 실측으로 고른 모델. `ollama list`의 이름과 정확히 맞아야 한다.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:latest

# --- Vertex AI (배포 + 임베딩) ---
# 임베딩은 개발·배포 공통이다. 청크 1,752건이 text-multilingual-embedding-002
# (768차원)으로 적재돼 있어, 검색 질의도 같은 모델로 임베딩해야 한다.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GEMINI_LOCATION=us-central1
# Pro는 건당 사고 토큰을 2,000~3,100개 쓴다(3단계 실측). 주력은 Flash로 둔다
GEMINI_MODEL=gemini-2.5-flash

# 역할별로 다른 모델을 쓸 수 있다. 비우면 위 기본값을 따른다
SAFETY_MODEL=
INTAKE_MODEL=
INTERPRET_MODEL=
COUNSEL_MODEL=
JOURNAL_MODEL=

# --- Anthropic (프롬프트 대조용) ---
# 키가 있으면 직결 API를, 없으면 Vertex를 쓴다.
# 모델 ID는 직결이 하이픈(-), Vertex가 @ 구분자로 다르다.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5-20250929
CLAUDE_LOCATION=us-east5

# 3단계 번역을 다시 돌릴 때만. 그때 쓴 모델을 그대로 고정해 둔다
# TRANSLATE_GEMINI_MODEL=gemini-2.5-pro

# --- 인증 경계 (T02-BE) ---
# 로컬 브라우저 테스트에서 dev-token을 쓰려면 true로 켠다. 기본값은 false다.
# ENVIRONMENT=production 이면 이 값이 true여도 열리지 않는다(이중 조건).
DEV_AUTH_BYPASS_ENABLED=false
# JWKS 조회 타임아웃(초). 라이브러리 기본값 30초는 너무 길다.
JWKS_TIMEOUT_SECONDS=3.0
# 검증된 사용자 기준 분당 한도. 토큰을 갱신해도 초기화되지 않는다.
USER_RATE_LIMIT_PER_MINUTE=30

# --- 출시 단계와 기능 게이트 (T01-BE) ---
# 운영 사실과 정책 승인은 코드가 판정하지 못한다. 기본값은 전부 닫는 쪽이며,
# 켜는 것은 운영자의 명시적 표시다. 판정 로직은 core/release_gate.py.
ENVIRONMENT=development

# free_beta = 결제 없음 (2026-09-07 결정). commercial 은 결제 구현·승인 후에만.
SERVICE_STAGE=free_beta
PURCHASE_ENABLED=false

# --- 무료 베타 크레딧 및 12시간 자동 충전 정책 ---
CONSULTATION_CREDIT_COST=10
WELCOME_CREDITS=50
FREE_BETA_REFILL_CREDITS=50
FREE_BETA_REFILL_HOURS=12
# 실제 판매 가능 여부는 이 문자열이 아니라 core/release_gate.py의
# SELLABLE_PAYMENT_PROVIDERS registry가 정한다. 어댑터를 구현한 사람이
# registry에 추가하기 전까지 commercial_launch_ready는 항상 false다.
PAYMENT_PROVIDER=mock
PAID_CREDIT_EXPIRY_ENABLED=false
QUALITY_REUSE_ENABLED=false

# 상담 생성 킬 스위치. 장애·비용 급증 시 false 로 내린다.
GENERATION_ENABLED=true

# 키가 있다는 이유만으로 다른 경로로 넘어가지 않게 막는 allowlist
LLM_ALLOWED_PROVIDERS=gemini,ollama,lmstudio,anthropic
LLM_ALLOWED_REGIONS=us-central1,us-east5

# 운영자가 확인을 마친 결정 ID (D01~D13). 코딩 에이전트가 채우지 않는다.
# 이 값만으로는 게이트가 열리지 않는다. 아래 증거가 함께 필요하다.
# 예: OPERATOR_ATTESTED_DECISIONS=D01,D02,D03,D04,D05,D10,D11,D12,D13
OPERATOR_ATTESTED_DECISIONS=

# --- 무료 베타 공개 증거 (CYCLE-01-R3) ---
# 코드는 형식과 미기입 여부만 검사한다. 값의 진위는 판정하지 못한다.
# 비워 두면 free_beta_ready=false다. 운영자만 기입한다.
#
# 게시된 정책 문서 묶음 버전. YYYY-MM-DD 또는 YYYY-MM-DD.N
# 로컬 개발 시에는 개발용 값을 지정할 수 있습니다 (예: LEGAL_DOCUMENTS_VERSION=2026-09-12).
# 비워 둘 경우 서버가 fail-closed(503 LEGAL_VERSION_UNSET)하여 정책 버전 없는 동의 기록 생성을 차단합니다.
LEGAL_DOCUMENTS_VERSION=
# 초안이 아니라 실제 게시 상태인지
LEGAL_DOCUMENTS_PUBLISHED=false
# 무료 베타 공개를 승인한 운영자와 승인일(YYYY-MM-DD)
FREE_BETA_LAUNCH_APPROVED_BY=
FREE_BETA_LAUNCH_APPROVED_AT=
# 인수기준 검증을 통과한 커밋의 40자리 SHA와 검사 묶음 버전.
# 이 두 값은 "기대값"이며 그 자체가 증거가 아니다. 아래 서명된 manifest가
# 같은 값을 담고 실제 PASS를 증명해야 한다.
ACCEPTANCE_EVIDENCE_SHA=
ACCEPTANCE_EVIDENCE_SUITE_VERSION=

# --- 인수증거 manifest (CYCLE-01-R4) ---
# 신뢰 경계: CI가 비공개 Ed25519 키로 manifest에 서명하고, 애플리케이션은
# 공개키로만 검증한다. 비공개키는 이 저장소에 두지 않는다. 아래 공개키 칸도
# 비워 둔다 — 실제 운영 공개키를 여기에 커밋하지 않는다.
#
# 현재 실제 CI 서명 단계는 없다. 따라서 기본값은 비어 있고 게이트는 닫혀 있다.
ACCEPTANCE_MANIFEST_PATH=
# DEPRECATED / no-op. 이 값은 더 이상 읽히지 않는다.
# 검증 공개키를 런타임 환경변수에서 읽으면, 배포 환경변수를 바꿀 수 있는 사람이
# 자기 키로 자기 manifest를 서명해 게이트를 열 수 있다. 그래서 신뢰 anchor를
# core/release_trust.py로 옮겼고, 코드 리뷰를 거친 빌드 입력으로만 바뀐다.
# 여기에 무엇을 넣어도 검증 결과는 달라지지 않는다.
ACCEPTANCE_EVIDENCE_PUBLIC_KEY=
# 빌드된 이미지가 나온 커밋. 빌드 시 주입한다. manifest의 target_sha와 일치해야
# 증거가 이 빌드에 묶인다.
BUILD_GIT_SHA=

# --- LLM 비용 상한 및 운영자 설정 (A02-R1) ---
# 예산 가드 활성화 여부. 비활성화는 이 플래그를 false로 두는 것으로만 수행한다.
LLM_BUDGET_ENABLED=true
# 일일/월간 비용 상한(USD). 0이면 0달러 한도(즉시 전면 차단)를 의미하며, 음수는 설정 모순으로 차단된다.
LLM_DAILY_COST_BUDGET_USD=10.0
LLM_MONTHLY_COST_BUDGET_USD=200.0
# 운영자 사용자 ID 목록 (콤마 구분 UUID). 비어 있으면 /api/ops/budget은 기본 폐쇄(404)된다.
OPERATOR_USER_IDS=

# --- 자체 방문자 통계 (운영 대시보드의 방문자수·재방문 횟수) ---
# 기본값 false. 개인정보처리방침에 방문 기록 수집을 고지한 뒤에 켠다.
VISITOR_ANALYTICS_ENABLED=false
# 방문자 식별자 해시용 서버 전용 비밀값. 16자 이상이어야 수집이 열린다.
# 예: openssl rand -hex 32 로 생성. 교체하면 기존 방문자가 신규로 잡힌다.
VISITOR_ID_PEPPER=
# 같은 방문자의 재접속을 한 방문으로 묶는 간격(분).
VISIT_SESSION_GAP_MINUTES=30
# 방문 로그 보존 기간(일). 경과분은 운영 대시보드 조회 시 파기된다.
VISIT_RETENTION_DAYS=180
