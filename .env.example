POSTGRES_USER=iching
POSTGRES_PASSWORD=changeme
POSTGRES_DB=iching
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://iching:changeme@localhost:5432/iching

# --- 어느 모델로 돌릴지 ---
# 시험은 로컬, 서비스는 상용 API다 (CLAUDE.md 모델 운영 절).
#   개발·시험  LLM_PROVIDER=ollama   비용 0으로 무제한 반복
#   배포       LLM_PROVIDER=gemini   Cloud Run이 가벼워야 scale-to-zero가 된다
LLM_PROVIDER=ollama

# --- 로컬 (개발·시험) ---
# 2026-08-16 실측으로 고른 모델. `ollama list`의 이름과 정확히 맞아야 한다.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:latest

# --- Vertex AI (배포 + 임베딩) ---
# 임베딩은 개발·배포 공통이다. 청크 1,752건이 text-multilingual-embedding-002
# (768차원)으로 적재돼 있어, 검색 질의도 같은 모델로 임베딩해야 한다.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GEMINI_LOCATION=us-central1
# Pro는 건당 사고 토큰을 2,000~3,100개 쓴다(3단계 실측). 주력은 Flash로 둔다
GEMINI_MODEL=gemini-2.5-flash

# 역할별로 다른 모델을 쓸 수 있다. 비우면 위 기본값을 따른다
SAFETY_MODEL=
INTAKE_MODEL=
INTERPRET_MODEL=
COUNSEL_MODEL=
JOURNAL_MODEL=

# --- Anthropic (프롬프트 대조용) ---
# 키가 있으면 직결 API를, 없으면 Vertex를 쓴다.
# 모델 ID는 직결이 하이픈(-), Vertex가 @ 구분자로 다르다.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5-20250929
CLAUDE_LOCATION=us-east5

# 3단계 번역을 다시 돌릴 때만. 그때 쓴 모델을 그대로 고정해 둔다
# TRANSLATE_GEMINI_MODEL=gemini-2.5-pro
