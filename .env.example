POSTGRES_USER=iching
POSTGRES_PASSWORD=changeme
POSTGRES_DB=iching
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://iching:changeme@localhost:5432/iching

# --- 생성 호출 (5단계 이후: Anthropic 직결) ---
# 키가 있으면 직결 API를, 없으면 Vertex를 쓴다. GCP 청구서에서 생성을 빼기 위해
# 직결을 기본으로 삼는다. 모델 ID는 직결이 하이픈, Vertex가 @ 구분자로 다르다.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5-20250929

# --- Vertex AI ---
# 5단계 이후 남는 용도는 임베딩 하나다. 청크 1,752건이 text-multilingual-embedding-002
# (768차원)으로 적재돼 있어, 검색 질의도 같은 모델로 임베딩해야 한다.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GEMINI_LOCATION=us-central1

# 아래 둘은 3단계 번역 이력용. 앞으로 쓰지 않는다
GEMINI_MODEL=gemini-2.5-pro
CLAUDE_LOCATION=us-east5
