ENVIRONMENT: "production"
LLM_PROVIDER: "gemini"
GOOGLE_CLOUD_PROJECT: "your-gcp-project-id"
GEMINI_MODEL: "gemini-2.5-flash"
# 프로덕션 배포 시 허용할 프론트엔드 도메인 (쉼표로 구분)
CORS_ORIGINS: "https://your-domain.vercel.app"
CRISIS_LATCH_HOURS: "24"
# 자체 방문자 통계. 개인정보처리방침 고지 후에 "true"로 올린다.
VISITOR_ANALYTICS_ENABLED: "false"
# 방문자 식별자 해시용 비밀값 (16자 이상). openssl rand -hex 32
VISITOR_ID_PEPPER: ""
VISIT_SESSION_GAP_MINUTES: "30"
VISIT_RETENTION_DAYS: "180"
# 무료 베타 12시간 자동 충전 정책
CONSULTATION_CREDIT_COST: "10"
WELCOME_CREDITS: "50"
FREE_BETA_REFILL_CREDITS: "50"
FREE_BETA_REFILL_HOURS: "12"
# Cloud Run 프록시 헤더 신뢰 설정 (X-Forwarded-For) - 구체적인 신뢰 CIDR 명시 (fail-closed)
FORWARDED_ALLOW_IPS: "169.254.0.0/16,130.211.0.0/22,35.191.0.0/16"

