# 프론트엔드 환경변수 (Next.js)
#
# NEXT_PUBLIC_* 는 빌드 시점에 번들에 박힌다. 값을 바꾸면 반드시 재빌드할 것 —
# 환경변수만 갈아끼우고 재배포하지 않으면 반영되지 않는다.
#
# 로컬: 이 파일을 frontend/.env.local 로 복사해 값을 채운다.
# 배포: Vercel → Settings → Environment Variables (Production 스코프)

# 백엔드 API. 비우면 localhost 폴백을 쓴다(로컬 개발용).
NEXT_PUBLIC_API_URL=http://localhost:8008

# Supabase. 폴백이 없으므로 비우면 앱이 시작되지 않는다.
# Supabase 대시보드 → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
