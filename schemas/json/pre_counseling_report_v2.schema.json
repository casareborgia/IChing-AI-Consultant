{
  "$defs": {
    "AcademicDetails": {
      "additionalProperties": false,
      "properties": {
        "casting": {
          "$ref": "#/$defs/CastingDetail"
        },
        "focus_rule": {
          "$ref": "#/$defs/FocusRuleDetail"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/ReportSource"
          },
          "maxItems": 30,
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        },
        "user_facts": {
          "items": {
            "$ref": "#/$defs/UserFact"
          },
          "maxItems": 30,
          "title": "User Facts",
          "type": "array"
        }
      },
      "required": [
        "casting",
        "focus_rule",
        "sources"
      ],
      "title": "AcademicDetails",
      "type": "object"
    },
    "CastingDetail": {
      "additionalProperties": false,
      "properties": {
        "changing_lines": {
          "items": {
            "type": "integer"
          },
          "maxItems": 6,
          "title": "Changing Lines",
          "type": "array"
        },
        "has_transformation": {
          "title": "Has Transformation",
          "type": "boolean"
        },
        "lines": {
          "items": {
            "$ref": "#/$defs/CastingLine"
          },
          "maxItems": 6,
          "minItems": 6,
          "title": "Lines",
          "type": "array"
        },
        "original_hexagram_id": {
          "maximum": 64,
          "minimum": 1,
          "title": "Original Hexagram Id",
          "type": "integer"
        },
        "original_lower_trigram": {
          "maxLength": 30,
          "minLength": 1,
          "title": "Original Lower Trigram",
          "type": "string"
        },
        "original_name": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Original Name",
          "type": "string"
        },
        "original_upper_trigram": {
          "maxLength": 30,
          "minLength": 1,
          "title": "Original Upper Trigram",
          "type": "string"
        },
        "transformed_hexagram_id": {
          "anyOf": [
            {
              "maximum": 64,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Transformed Hexagram Id"
        },
        "transformed_name": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Transformed Name"
        }
      },
      "required": [
        "lines",
        "original_hexagram_id",
        "original_name",
        "original_lower_trigram",
        "original_upper_trigram",
        "has_transformation"
      ],
      "title": "CastingDetail",
      "type": "object"
    },
    "CastingLine": {
      "additionalProperties": false,
      "properties": {
        "is_changing": {
          "title": "Is Changing",
          "type": "boolean"
        },
        "line_type_ko": {
          "maxLength": 20,
          "minLength": 1,
          "title": "Line Type Ko",
          "type": "string"
        },
        "position": {
          "maximum": 6,
          "minimum": 1,
          "title": "Position",
          "type": "integer"
        },
        "value": {
          "maximum": 9,
          "minimum": 6,
          "title": "Value",
          "type": "integer"
        }
      },
      "required": [
        "position",
        "value",
        "line_type_ko",
        "is_changing"
      ],
      "title": "CastingLine",
      "type": "object"
    },
    "CounselingHandoff": {
      "additionalProperties": false,
      "description": "다음 상담 턴으로 넘기는 것.\n\n무엇이 확인됐고 무엇이 아직 아닌지를 갈라 둔다. 이 구분이 없으면 리포트의\n잠정 해석이 다음 턴에서 확정 사실로 굳는다.\n\n카드 B에서는 생성·저장만 한다. 5턴 상담이 이 구조를 실제로 소비하는 것은\n카드 E다.",
      "properties": {
        "opening_question": {
          "maxLength": 200,
          "minLength": 5,
          "title": "Opening Question",
          "type": "string"
        },
        "suggested_action_title": {
          "maxLength": 100,
          "minLength": 2,
          "title": "Suggested Action Title",
          "type": "string"
        },
        "unconfirmed_points": {
          "items": {
            "type": "string"
          },
          "maxItems": 5,
          "title": "Unconfirmed Points",
          "type": "array"
        },
        "working_hypotheses": {
          "items": {
            "type": "string"
          },
          "maxItems": 5,
          "title": "Working Hypotheses",
          "type": "array"
        }
      },
      "required": [
        "suggested_action_title",
        "opening_question"
      ],
      "title": "CounselingHandoff",
      "type": "object"
    },
    "EmotionalContext": {
      "additionalProperties": false,
      "description": "지금의 마음과 상황.\n\n`validation`은 사용자가 실제로 말한 것에 대한 공감이다. `pattern_hypothesis`는\n관찰된 적 없는 반복 패턴이라 **가설**로만 존재한다 — 없으면 `null`이고,\n있어도 상담에서 확인할 대상이지 확정 사실이 아니다.",
      "properties": {
        "pattern_hypothesis": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pattern Hypothesis"
        },
        "user_fact_refs": {
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "title": "User Fact Refs",
          "type": "array"
        },
        "validation": {
          "maxLength": 800,
          "minLength": 10,
          "title": "Validation",
          "type": "string"
        }
      },
      "required": [
        "validation"
      ],
      "title": "EmotionalContext",
      "type": "object"
    },
    "FocusRuleDetail": {
      "additionalProperties": false,
      "properties": {
        "body_use_note_ko": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Body Use Note Ko"
        },
        "body_use_type": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Body Use Type",
          "type": "string"
        },
        "changing_count": {
          "maximum": 6,
          "minimum": 0,
          "title": "Changing Count",
          "type": "integer"
        },
        "description_ko": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Description Ko",
          "type": "string"
        },
        "focus_type": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Focus Type",
          "type": "string"
        },
        "rule_version": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Rule Version",
          "type": "string"
        },
        "target_hexagram_type": {
          "maxLength": 20,
          "minLength": 1,
          "title": "Target Hexagram Type",
          "type": "string"
        },
        "target_line_numbers": {
          "items": {
            "type": "integer"
          },
          "maxItems": 6,
          "title": "Target Line Numbers",
          "type": "array"
        }
      },
      "required": [
        "changing_count",
        "focus_type",
        "target_hexagram_type",
        "description_ko",
        "body_use_type",
        "rule_version"
      ],
      "title": "FocusRuleDetail",
      "type": "object"
    },
    "GenerationMetadata": {
      "additionalProperties": false,
      "description": "무엇으로 만들었는지. **지어내지 않는다.**\n\n클라이언트가 확인해 주지 않는 상세 모델 버전은 `null`로 둔다 — 모르는 것을\n적어 두면 나중에 그 값으로 재현을 시도하게 된다.",
      "properties": {
        "evidence_snapshot_hash": {
          "maxLength": 64,
          "minLength": 8,
          "title": "Evidence Snapshot Hash",
          "type": "string"
        },
        "generated_at": {
          "description": "타임존 포함 ISO-8601",
          "maxLength": 40,
          "minLength": 10,
          "title": "Generated At",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "maxLength": 120,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "prompt_version": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Prompt Version",
          "type": "string"
        },
        "provider": {
          "anyOf": [
            {
              "maxLength": 60,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        },
        "repair_count": {
          "maximum": 1,
          "minimum": 0,
          "title": "Repair Count",
          "type": "integer"
        },
        "rule_version": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Rule Version",
          "type": "string"
        }
      },
      "required": [
        "generated_at",
        "prompt_version",
        "rule_version",
        "evidence_snapshot_hash",
        "repair_count"
      ],
      "title": "GenerationMetadata",
      "type": "object"
    },
    "MicroActionTask": {
      "additionalProperties": false,
      "description": "오늘 시도해 볼 작은 행동.\n\n`duration_minutes`의 상한이 15인 것은 수행 가능성 때문이다. 10분은 기본 제안이지\n고정값이 아니다. 사용자의 생활 조건(퇴근 시각, 업무 알림 정책)을 모르면\n`when`에 특정 시각을 강제하지 않는다.\n\n**이 칸은 제안이다.** 사용자가 고른 적도 끝낸 적도 없다. 선택·완료는 별도\n상태로 관리한다(카드 C).",
      "properties": {
        "completion_criterion": {
          "maxLength": 200,
          "minLength": 5,
          "title": "Completion Criterion",
          "type": "string"
        },
        "duration_minutes": {
          "maximum": 15,
          "minimum": 1,
          "title": "Duration Minutes",
          "type": "integer"
        },
        "smaller_alternative": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Smaller Alternative"
        },
        "steps": {
          "items": {
            "type": "string"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Steps",
          "type": "array"
        },
        "title": {
          "maxLength": 100,
          "minLength": 2,
          "title": "Title",
          "type": "string"
        },
        "when": {
          "maxLength": 200,
          "minLength": 2,
          "title": "When",
          "type": "string"
        }
      },
      "required": [
        "title",
        "duration_minutes",
        "when",
        "steps",
        "completion_criterion"
      ],
      "title": "MicroActionTask",
      "type": "object"
    },
    "Perspective": {
      "additionalProperties": false,
      "description": "다른 각도에서 살펴보기.\n\n`classical_reading`과 `applied_reading`이 갈라져 있는 것이 이 모델의 핵심이다.\n한 칸이면 \"利用獄은 인지적 탈융합을 뜻합니다\"가 나온다 — 원전의 뜻이 현대\n심리 용어로 대체된 것이고, 고전이 그렇게 말한 적은 없다. 두 칸이면\n\"옥사를 다스린다는 것은 …\"(고전)과 \"이번 사연에 옮기면 …\"(적용)이 각각 제 자리에\n선다.",
      "properties": {
        "alternative_perspective": {
          "maxLength": 800,
          "minLength": 10,
          "title": "Alternative Perspective",
          "type": "string"
        },
        "applied_reading": {
          "maxLength": 800,
          "minLength": 10,
          "title": "Applied Reading",
          "type": "string"
        },
        "classical_reading": {
          "maxLength": 500,
          "minLength": 10,
          "title": "Classical Reading",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        },
        "thought_observation": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Thought Observation"
        }
      },
      "required": [
        "classical_reading",
        "applied_reading",
        "alternative_perspective",
        "evidence_refs"
      ],
      "title": "Perspective",
      "type": "object"
    },
    "ReportNarrative": {
      "additionalProperties": false,
      "properties": {
        "emotional_context": {
          "$ref": "#/$defs/EmotionalContext"
        },
        "headline_metaphor": {
          "maxLength": 200,
          "minLength": 5,
          "title": "Headline Metaphor",
          "type": "string"
        },
        "micro_action_task": {
          "$ref": "#/$defs/MicroActionTask"
        },
        "perspective": {
          "$ref": "#/$defs/Perspective"
        },
        "value_direction": {
          "$ref": "#/$defs/ValueDirection"
        }
      },
      "required": [
        "headline_metaphor",
        "emotional_context",
        "perspective",
        "value_direction",
        "micro_action_task"
      ],
      "title": "ReportNarrative",
      "type": "object"
    },
    "ReportSource": {
      "additionalProperties": false,
      "description": "근거 한 건의 스냅샷.\n\n`locator`는 확인된 원전 위치만 담는다. 『역학계몽』의 편명·페이지를 추측해\n적지 않는다 — 저장소가 확인한 범위는 `data/PROVENANCE.md`에 있다.",
      "properties": {
        "annotation": {
          "anyOf": [
            {
              "maxLength": 4000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "검색된 주석 본문 스냅샷",
          "title": "Annotation"
        },
        "annotation_source": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Annotation Source"
        },
        "classical_text": {
          "description": "원문. 번역으로 대신하지 않는다",
          "maxLength": 2000,
          "minLength": 1,
          "title": "Classical Text",
          "type": "string"
        },
        "classical_translation": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Classical Translation"
        },
        "hexagram_id": {
          "maximum": 64,
          "minimum": 1,
          "title": "Hexagram Id",
          "type": "integer"
        },
        "hexagram_name": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Hexagram Name",
          "type": "string"
        },
        "id": {
          "description": "이 리포트 안에서만 유효한 근거 ID",
          "pattern": "^E\\d{1,3}$",
          "title": "Id",
          "type": "string"
        },
        "line_number": {
          "anyOf": [
            {
              "maximum": 7,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line Number"
        },
        "locator": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "확인된 원전 위치. 불명이면 null",
          "title": "Locator"
        },
        "role": {
          "$ref": "#/$defs/SourceRole"
        }
      },
      "required": [
        "id",
        "role",
        "hexagram_id",
        "hexagram_name",
        "classical_text"
      ],
      "title": "ReportSource",
      "type": "object"
    },
    "SourceRole": {
      "description": "근거가 이번 판단에서 맡은 자리.",
      "enum": [
        "primary",
        "auxiliary",
        "background",
        "body_use",
        "supplement",
        "annotation"
      ],
      "title": "SourceRole",
      "type": "string"
    },
    "UserFact": {
      "additionalProperties": false,
      "description": "사용자가 실제로 쓴 문장의 발췌. 서술이 사실이라고 주장할 수 있는 유일한 근거다.",
      "properties": {
        "id": {
          "pattern": "^U\\d{1,3}$",
          "title": "Id",
          "type": "string"
        },
        "text": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "id",
        "text"
      ],
      "title": "UserFact",
      "type": "object"
    },
    "ValueDirection": {
      "additionalProperties": false,
      "description": "지키고 싶은 가치와 점검할 조건.\n\n지괘가 들어오는 자리다. 확정적 미래나 파국 예고가 아니라 `conditions_to_check`\n— 선택할 때 무엇을 살펴볼지다.",
      "properties": {
        "conditions_to_check": {
          "items": {
            "type": "string"
          },
          "maxItems": 5,
          "minItems": 1,
          "title": "Conditions To Check",
          "type": "array"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        },
        "proposed_value": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Proposed Value"
        },
        "rationale": {
          "maxLength": 800,
          "minLength": 10,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "rationale",
        "conditions_to_check",
        "evidence_refs"
      ],
      "title": "ValueDirection",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "점괘 사전 분석 리포트 v2.\n\n본문은 **생성 시점의 스냅샷**이다. 사용자의 행동 선택·완료 같은 현재 상태를\n이 JSON 안에서 계속 덮어쓰지 않는다.",
  "properties": {
    "academic_details": {
      "$ref": "#/$defs/AcademicDetails"
    },
    "counseling_handoff": {
      "$ref": "#/$defs/CounselingHandoff"
    },
    "generation_metadata": {
      "$ref": "#/$defs/GenerationMetadata"
    },
    "narrative": {
      "$ref": "#/$defs/ReportNarrative"
    },
    "report_id": {
      "maxLength": 36,
      "minLength": 36,
      "title": "Report Id",
      "type": "string"
    },
    "schema_version": {
      "default": "2.0",
      "pattern": "^2\\.0$",
      "title": "Schema Version",
      "type": "string"
    },
    "session_id": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Session Id",
      "type": "string"
    }
  },
  "required": [
    "report_id",
    "session_id",
    "narrative",
    "academic_details",
    "counseling_handoff",
    "generation_metadata"
  ],
  "title": "PreCounselingReport",
  "type": "object"
}
